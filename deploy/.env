# .env — дополнения/переопределения поверх дефолтного .env из self-hosted-repo
COMPOSE_PROJECT_NAME=sentry-self-hosted
COMPOSE_PROFILES=feature-complete

# Изоляция: все сервисы на внутренней сети Docker, наружу отдаётся nginx
SENTRY_BIND=9000

# Хранение событий 90 дней
SENTRY_EVENT_RETENTION_DAYS=90

# Пины образов на конкретный релиз (вместо floating tag)
SENTRY_IMAGE=ghcr.io/getsentry/sentry:26.8.0
SNUBA_IMAGE=ghcr.io/getsentry/snuba:26.8.0
RELAY_IMAGE=ghcr.io/getsentry/relay:26.8.0
SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:26.8.0
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:26.8.0

# Почта через MailHog (override)
# mail.host/port задавались средствами Sentry (options), см. ниже